<NotepadPlus>
    <UserLang name="BBCode" ext="BBCode BB" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="yes" allowFoldOfComments="no" foldCompact="no" forcePureLC="2" decimalSeparator="0" />
            <Prefix Keywords1="yes" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00 01 02 03 04&#x000A;</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1"></Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1">:D :) ;) :( :o :shock: :? 8-) :lol: :x :P :oops: :cry: :evil: :twisted: :roll: :!: :?: :idea: :arrow: :| :mrgreen: :geek: :ugeek: :wsl: :popcorn: :wip: :banana: :banghead: :bowdown: :buttrock: :cheer: :cheers: :pom: :bmd: &#x000A;</Keywords>
            <Keywords name="Operators2"></Keywords>
            <Keywords name="Folders in code1, open">[code] [c] [Codebox=lua file=Untitled.lua]</Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close">[/code] [/c] [/Codebox]</Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in comment, open">[spoiler]</Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close">[/spoiler]</Keywords>
            <Keywords name="Keywords1">http:// =http:// https:// =https:// mailto: =mailto: ftp:// =ftp:// ftps:// =ftps://</Keywords>
            <Keywords name="Keywords2"></Keywords>
            <Keywords name="Keywords3"></Keywords>
            <Keywords name="Keywords4"></Keywords>
            <Keywords name="Keywords5"></Keywords>
            <Keywords name="Keywords6"></Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
            <Keywords name="Delimiters">00[img] 00[mp4] 00[attachment] 00[attachment=] 00[url] 00[url=] 01 02[/img] 02[/mp4] 02[/attachment] 02[/url] 03[s] 04 05[/s] 06[mention] 07 08[/mention] 09[list] 09[*] 10 11[/list] 12[b] 12[h2] 13 14[/b] 14[/h2] 15[i] 16 17[/i] 18[size= 18[quote= 18[color] 18[color= 19 20[/size] 20[/quote] 20[/color] 21[u] 22 23[/u]</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="DCDCCC" bgColor="3F3F3F" fontStyle="0" nesting="0" />
            <WordsStyle name="COMMENTS" fgColor="FF8040" bgColor="FFFFFF" fontStyle="1" nesting="256" />
            <WordsStyle name="LINE COMMENTS" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="DCDCCC" bgColor="3F3F3F" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="EDD6ED" bgColor="FFFFFF" fontStyle="4" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS5" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS6" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS7" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS8" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="OPERATORS" fgColor="DFC47D" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="7F9F7F" bgColor="FFFFFF" colorStyle="2" fontName="Consolas" fontStyle="3" nesting="0" />
            <WordsStyle name="FOLDER IN CODE2" fgColor="000000" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="FOLDER IN COMMENT" fgColor="CEDF99" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS1" fgColor="EDD6ED" bgColor="FFFFFF" fontStyle="2" nesting="256" />
            <WordsStyle name="DELIMITERS2" fgColor="8C40FF" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS3" fgColor="FF8040" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS4" fgColor="8CD0D3" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS5" fgColor="E3CEAB" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS6" fgColor="E3CEAB" bgColor="FFFFFF" fontStyle="2" nesting="0" />
            <WordsStyle name="DELIMITERS7" fgColor="7F9F7F" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS8" fgColor="E3CEAB" bgColor="FFFFFF" fontStyle="4" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
